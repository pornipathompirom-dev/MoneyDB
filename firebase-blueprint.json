{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "An income or expense transaction record",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns this transaction",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"],
          "description": "Type of transaction"
        },
        "amount": {
          "type": "number",
          "description": "Transaction amount in Thai Baht"
        },
        "category": {
          "type": "string",
          "maxLength": 60,
          "description": "Category name for grouping"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Description or note of the transaction"
        },
        "date": {
          "type": "string",
          "maxLength": 30,
          "description": "Date of transaction in YYYY-MM-DD format"
        },
        "month": {
          "type": "string",
          "maxLength": 7,
          "description": "Month of transaction in YYYY-MM format"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["userId", "type", "amount", "category", "title", "date", "month", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User preferences and metadata",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "The UID of the user"
        },
        "email": {
          "type": "string",
          "maxLength": 120,
          "description": "User Google email"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "User avatar photo URL"
        },
        "monthlyBudget": {
          "type": "number",
          "description": "Target monthly spending budget in THB"
        },
        "currency": {
          "type": "string",
          "maxLength": 10,
          "description": "Currency code e.g. THB"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["userId", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile and preferences"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Subcollection storing financial transactions for each user"
    }
  }
}
